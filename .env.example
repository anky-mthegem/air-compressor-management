# ==============================================================
# Air Compressor Management - Settings
# ==============================================================

# Web Server
APP_NAME=Air Compressor Management
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database (MS SQL Server)
# If MSSQL cannot connect or server is not running, app automatically falls back to local SQLite!
DB_TYPE=mssql
MSSQL_SERVER=localhost\SQLEXPRESS
MSSQL_DATABASE=CompressorDB
MSSQL_USERNAME=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_TRUSTED_CONNECTION=True

# Siemens S7-1200 PLC Connection
# Set PLC_ENABLED=True when connected to physical PLC hardware.
# When False, the built-in Compressor Digital Twin Simulator runs.
PLC_ENABLED=False
PLC_IP=192.168.0.1
PLC_RACK=0
PLC_SLOT=1
PLC_DB_NUMBER=1
PLC_POLL_INTERVAL_SEC=2.0

# Local AI Chatbot (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_FALLBACK_TO_HEURISTIC=True

# Compressor Rated Limits
COMPRESSOR_TAG=CMP-01
RATED_POWER_KW=75.0
RATED_FLOW_CFM=480.0
TARGET_PRESSURE_MIN_BAR=6.5
TARGET_PRESSURE_MAX_BAR=7.5
AIREND_TEMP_WARN_C=98.0
AIREND_TEMP_TRIP_C=105.0
SEPARATOR_DP_WARN_BAR=0.8
